{
  "name": "Vehicle",
  "sheetName": "Vehicles",
  "storage": {
    "provider": "google-sheets",
    "sheetName": "BKFW_Vehicles",
    "mode": "framework"
  },
  "primaryKey": "id",
  "permissions": {
    "read": ["admin", "duty_officer"],
    "create": ["admin"],
    "update": ["admin"],
    "delete": ["admin"]
  },
  "fields": [
